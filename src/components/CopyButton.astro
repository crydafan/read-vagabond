---
export interface Props {
  copyData: string;
  ariaLabel: string;
}

const { copyData, ariaLabel } = Astro.props;
---

<button
  type="button"
  data-copy={copyData}
  aria-label={ariaLabel}
  class="copy-button inline-flex items-center justify-center gap-2 text-gray-900 dark:text-white bg-white dark:bg-neutral-950 border border-gray-300 dark:border-neutral-700 hover:bg-gray-100 dark:hover:bg-neutral-900 focus:ring-4 focus:ring-gray-100 dark:focus:ring-neutral-800 font-medium rounded-lg text-sm px-4 py-2 text-center w-full sm:w-auto shrink-0 focus:outline-none"
>
  <span class="copy-label">Copy</span>
  <i class="fa fa-copy"></i>
</button>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>(".copy-button");
    if (!button) return;

    const address = button.dataset.copy;
    if (!address) return;

    navigator.clipboard.writeText(address).then(() => {
      const label = button.querySelector(".copy-label");
      if (!label) return;

      const original = label.textContent;
      label.textContent = "Copied!";
      setTimeout(() => {
        label.textContent = original;
      }, 1500);
    });
  });
</script>
