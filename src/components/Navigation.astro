---
import ThemeToggle from "./ThemeToggle.astro";
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-white/80 dark:bg-black/80 backdrop-blur-md border-b border-gray-200/50 dark:border-neutral-800/50"
>
  <div
    class="relative max-w-7xl flex flex-wrap items-center justify-center md:justify-between mx-auto p-4"
  >
    <a href="/">
      <img src="/Vagabond_Logo.webp" alt="Vagabond" class="h-15 dark:invert" />
    </a>
    <div
      class="absolute right-4 top-1/2 -translate-y-1/2 md:static md:translate-y-0"
    >
      <ThemeToggle />
    </div>
  </div>
</nav>
