---
import type { GetStaticPaths } from "astro";
import ChapterLayout from "../../../layouts/ChapterLayout.astro";
import {
  getMangaVolumeByNumber,
  getMangaChapterByNumber,
  getMangaVolumes,
} from "@read-vagabond/db";
import { buildPageUrl } from "../../../lib/page";

export const getStaticPaths = (async () => {
  const volumes = await getMangaVolumes();
  const paths: { params: { volume: string; chapter: string } }[] = [];

  for (const volume of volumes) {
    const firstChapter = volume.firstChapter ?? 0;
    const lastChapter = volume.lastChapter ?? 0;

    for (
      let chapterNum = firstChapter;
      chapterNum <= lastChapter;
      chapterNum++
    ) {
      paths.push({
        params: {
          volume: String(volume.number),
          chapter: String(chapterNum),
        },
      });
    }
  }

  return paths;
}) satisfies GetStaticPaths;

const { volume: volumeNumber, chapter: chapterNumber } = Astro.params;

if (!volumeNumber || !chapterNumber) {
  return Astro.redirect("/");
}

const volume = await getMangaVolumeByNumber(+volumeNumber);
if (!volume) {
  return Astro.redirect("/");
}

const chapter = await getMangaChapterByNumber(+chapterNumber);
if (!chapter) {
  return Astro.redirect(`/volume-${volume.number}`);
}

const firstChapter = volume.firstChapter ?? 0;
const lastChapter = volume.lastChapter ?? 0;

if (chapter.number > lastChapter || chapter.number < firstChapter) {
  return Astro.redirect(`/volume-${volume.number}`);
}

const prevChapter = chapter.number > firstChapter ? chapter.number - 1 : null;
const nextChapter = chapter.number < lastChapter ? chapter.number + 1 : null;

const pagesUrl = Array.from({ length: chapter.pageCount }, (_, i) =>
  buildPageUrl({
    volume: volume.number,
    chapter: chapter.number,
    page: i + 1,
  }),
);
---

<ChapterLayout
  tagline={`Volume ${volume.number} - Chapter ${chapter.number} - ${chapter.title}`}
  metadata={{
    title: `Read Vagabond Manga | Volume ${volume.number} - Chapter ${chapter.number} - ${chapter.title}`,
    description: `Read Vagabond Chapter ${chapter.number}: ${chapter.title} online for free. ${chapter.pageCount} pages of high-quality manga from Takehiko Inoue's masterpiece.`,
    keywords: [
      `Vagabond Chapter ${chapter.number}`,
      `${chapter.title}`,
      "read manga online",
      "Takehiko Inoue",
      `Vagabond Volume ${volume.number}`,
    ],
    endpoint: `/volume-${volume.number}/chapter-${chapter.number}`,
  }}
  volume={volume.number}
  chapter={{
    number: chapter.number,
    title: chapter.title,
    pagesUrl: pagesUrl,
  }}
  prevChapter={prevChapter}
  nextChapter={nextChapter}
/>
